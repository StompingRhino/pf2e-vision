{
  "id": "pf2e-vision",
  "title": "PF2e Vision",
  "description": "Directional visibility (observed, concealed, hidden, undetected, unnoticed) between tokens for PF2e combat: GM matrix, player-side token visuals, flat checks, off-guard, Hide/Sneak/Seek.",
  "version": "1.0.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14.364"
  },
  "authors": [
    {
      "name": "StompingRhino"
    }
  ],
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "styles/pf2e-vision.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "ru",
      "name": "Русский",
      "path": "lang/ru.json"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {
          "minimum": "8.1.0"
        }
      }
    ],
    "requires": [
      {
        "id": "lib-wrapper",
        "type": "module"
      }
    ]
  }
}
