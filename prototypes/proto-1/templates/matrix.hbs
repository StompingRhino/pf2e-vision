<section class="p1-matrix">
  {{#if empty}}
    <p class="p1-empty">{{localize "PF2EVP1.Empty"}}</p>
  {{else}}
    <label class="p1-fill">{{localize "PF2EVP1.FillWith"}}
      <select name="fill">
        {{#each levels}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </label>
    <table>
      <thead>
        <tr>
          <th class="corner">{{localize "PF2EVP1.Observer"}} \ &rarr;</th>
          {{#each rows}}
          <th class="target">
            <img src="{{img}}" alt="" data-tooltip="{{name}}">
            <button type="button" class="p1-bulk" data-action="fillColumn" data-target="{{tokenId}}" data-tooltip="{{@root.colTip}}"><i class="fa-solid fa-arrow-down"></i></button>
          </th>
          {{/each}}
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
        <tr>
          <th class="observer">
            <img src="{{img}}" alt=""><span>{{name}}</span>
            <button type="button" class="p1-bulk" data-action="fillRow" data-observer="{{tokenId}}" data-tooltip="{{@root.rowTip}}"><i class="fa-solid fa-arrow-right"></i></button>
          </th>
          {{#each cells}}
          <td class="{{#if self}}diag{{/if}}">
            {{#unless self}}
            <div class="p1-seg">
              {{#each buttons}}
              <button type="button" class="lvl {{key}} {{#if active}}active{{/if}}" data-action="setLevel"
                data-observer="{{../observerId}}" data-target="{{../targetId}}" data-level="{{key}}" data-tooltip="{{tip}}"
                style="background-image:url('{{icon}}')"></button>
              {{/each}}
            </div>
            {{/unless}}
          </td>
          {{/each}}
        </tr>
        {{/each}}
      </tbody>
    </table>
  {{/if}}
</section>
